---
bases:
  - "../../defaults/helm-defaults.yaml"
---
{{- $root := .Values }}

releases:
  {{- $layer := $root.deployLayer | default "" }}
  {{- if or (eq $layer "") (eq $layer "instance") }}
  {{- range $id, $instance := $root.global.instances }}
  {{- if eq $instance.component "wordpress" }}
  {{- /* Realm auth domain: matching global.realms entry, else idm.<domain>. */}}
  {{- $realmDomain := printf "idm.%s" $root.global.domain }}
  {{- range $r := ($root.global.realms | default list) }}
    {{- if eq $r.name $instance.realm }}{{- $realmDomain = $r.domain }}{{- end }}
  {{- end }}
  {{- $issuer := printf "https://%s/realms/%s" $realmDomain $instance.realm }}
  {{- /* Server-to-server calls go to Keycloak in-cluster (issuer stays public). */}}
  {{- $kcInternal := printf "http://keycloak-app-keycloakx-http.%s.svc.cluster.local/realms/%s" $root.global.instanceSlug $instance.realm }}
  {{- $primaryUrl := printf "https://%s" (index $instance.domains 0) }}
  - name: wordpress-{{ $id }}
    labels:
      component: wordpress
      instance: {{ $id }}
    namespace: {{ $root.global.instanceSlug }}-{{ $id }}
    chart: ./charts/wordpress
    createNamespace: {{ $root.global.createNamespaces }}
    installed: true
    values:
      - values/base-values.yaml.gotmpl
      - values/{{ $root.global.profile }}-values.yaml.gotmpl
      # Platform-derived defaults — minimal per-instance config lives in
      # global.instances.<id> (component, realm, domains, optional values).
      - wordpress:
          siteUrl: {{ $primaryUrl | quote }}
          homeUrl: {{ $primaryUrl | quote }}
          adminEmail: {{ $root.global.initialUserEmail | quote }}
        # Tenant on the shared mariadb-operator server (components/wordpress/mariadb.yaml
        # declares the matching Database/User/Grant CRs).
        database:
          host: mariadb-shared.{{ $root.global.instanceSlug }}.svc.cluster.local
          user: wordpress_{{ $id | replace "-" "_" }}
          name: wordpress_{{ $id | replace "-" "_" }}
        oauth:
          enabled: true
          clientId: {{ $id | quote }}
          # Client secret is generated by the secrets component alongside the
          # Keycloak client import (same value on both sides).
          existingSecret: keycloak-client-{{ $id }}
          existingSecretKey: client-secret
          endpointLogin: "{{ $issuer }}/protocol/openid-connect/auth"
          endpointLogout: "{{ $issuer }}/protocol/openid-connect/logout"
          issuer: {{ $issuer | quote }}
          endpointUserInfo: "{{ $kcInternal }}/protocol/openid-connect/userinfo"
          endpointToken: "{{ $kcInternal }}/protocol/openid-connect/token"
          jwksUri: "{{ $kcInternal }}/protocol/openid-connect/certs"
      # Per-instance overrides from global.instances.<id>.values (optional).
      - {{ index $instance "values" | default dict | toYaml | nindent 8 }}
  {{- end }}
  {{- end }}
  {{- end }}

commonLabels:
  component: wordpress
