# Copy to .env (never commit .env).
DB_PASSWORD=change-me

# Salts (required, the image refuses to run without them). Fill each with
# 64 random characters, e.g.: openssl rand -base64 48
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Optional OIDC login (Keycloak). Leave OIDC_CLIENT_ID empty for the normal
# WordPress login. When set, password login is off and users need a client role
# (admin, editor, author, contributor, subscriber) of this client.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile offline_access
OIDC_ISSUER=https://auth.example.com/realms/example
OIDC_ENDPOINT_LOGIN=https://auth.example.com/realms/example/protocol/openid-connect/auth
OIDC_ENDPOINT_LOGOUT=https://auth.example.com/realms/example/protocol/openid-connect/logout
OIDC_ENDPOINT_TOKEN=https://auth.example.com/realms/example/protocol/openid-connect/token
OIDC_ENDPOINT_USERINFO=https://auth.example.com/realms/example/protocol/openid-connect/userinfo
OIDC_JWKS_URI=https://auth.example.com/realms/example/protocol/openid-connect/certs
OIDC_IDENTITY_KEY=preferred_username
OIDC_NICKNAME_KEY=preferred_username
OIDC_EMAIL_FORMAT={email}
OIDC_DISPLAYNAME_FORMAT={given_name} {family_name}
OIDC_LINK_EXISTING_USERS=true
OIDC_CREATE_IF_NOT_EXISTS=true
OIDC_REDIRECT_BACK=true
OIDC_IDENTIFY_WITH_USERNAME=false
OIDC_ENABLE_REFRESH_TOKEN=true
OIDC_ENFORCE_PRIVACY=false
# Optional: one IP that may still use password login (break glass)
OIDC_BREAK_GLASS_IP=
